includeConfig 'conf/modules.config'

conda.enabled = true
report.overwrite = true

params{
    // HPA settings
    PAMlen = 4
    PAMpos = 3
}
params{
    GUIDESEQDIR = "$projectDir/modules/guideseq"

    // Path to conda env
    genomePAM = "/path/to/env/genomePAM"
    
    // Reference genome (bwa indexed)
    hg38 = "/path/to/bwa_indexed/hg38.fna"
}

// ---- Dynamically detect machine resources for the local executor ----
// Resolve the effective limits INTO params.max_cpus / params.max_memory here,
// so that the main.nf startup banner and BWATHREADS validation see real values
// (not null). CLI --max_cpus / --max_memory still take precedence over these
// autodetected defaults, because command-line params override config values.
params {
    // CPU: auto-detect (reserve 2 cores for the system)
    max_cpus = Runtime.runtime.availableProcessors() - 2

    // Memory: read /proc/meminfo (reserve 8 GB for the OS); fall back on non-Linux platforms
    max_memory = {
        def mem_total_kb = 0L
        try {
            def mem_line = new File('/proc/meminfo').readLines().find { it.startsWith('MemTotal') }
            if (mem_line != null) {
                mem_total_kb = mem_line.split()[1].toLong()
            }
        } catch (Exception ignored) {
            // /proc/meminfo not available (non-Linux platform) -> fall back to default below
        }
        return mem_total_kb > 0
            ? "${Math.max(4, (mem_total_kb / 1024 / 1024).toLong() - 8)}GB"
            : '250GB'
    }()
}

executor {
    name = 'local'
    cpus = params.max_cpus
    memory = params.max_memory
}