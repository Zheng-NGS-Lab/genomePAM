includeConfig 'conf/modules.config'

conda.enabled = true
report.overwrite = true

params{
    // HPA settings
    PAMlen = 4
    PAMpos = 3

    // Resource override knobs for the local executor (null = auto-detect)
    max_cpus = null
    max_memory = null
}
params{
    GUIDESEQDIR = "$projectDir/modules/guideseq"

    // Path to conda env
    genomePAM = "/path/to/env/genomePAM"
    
    // Reference genome (bwa indexed)
    hg38 = "/path/to/bwa_indexed/hg38.fna"
}

// ---- Dynamically detect machine resources for the local executor ----
// Override on the command line with --max_cpus / --max_memory.
executor {
    name = 'local'

    // CPU: prefer --max_cpus from CLI, otherwise auto-detect (reserve 2 cores for the system)
    cpus = params.max_cpus ?: (Runtime.runtime.availableProcessors() - 2)

    // Memory: prefer --max_memory from CLI, otherwise read /proc/meminfo (reserve 8 GB for the OS)
    memory = params.max_memory ?: {
        def mem_total_kb = 0L
        try {
            def mem_line = new File('/proc/meminfo').readLines().find { it.startsWith('MemTotal') }
            if (mem_line != null) {
                mem_total_kb = mem_line.split()[1].toLong()
            }
        } catch (Exception ignored) {
            // /proc/meminfo not available (non-Linux platform) -> fall back to default below
        }
        return mem_total_kb > 0
            ? "${Math.max(4, (mem_total_kb / 1024 / 1024).toLong() - 8)}GB"
            : '250GB'
    }()
}